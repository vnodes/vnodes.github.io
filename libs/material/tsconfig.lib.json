{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": [],
    "paths": {
      "@vnodes/material": [
        "./src/public-api.ts"
      ],
      "@vnodes/material/flex": [
        "./src/flex/public-api.ts"
      ],
      "@vnodes/material/form": [
        "./src/form/public-api.ts"
      ],
      "@vnodes/material/input-number": [
        "./src/input-number/public-api.ts"
      ],
      "@vnodes/material/input-text": [
        "./src/input-text/public-api.ts"
      ],
      "@vnodes/material/input": [
        "./src/input/public-api.ts"
      ],
      "@vnodes/material/number-filter": [
        "./src/number-filter/public-api.ts"
      ],
      "@vnodes/material/utils": [
        "./src/utils/public-api.ts"
      ],
    }
  },
  "include": [
    "./src/*.ts"
  ],
  "exclude": [
    "./src/**/*.spec.ts",
    "**/*.stories.ts"
  ]
}